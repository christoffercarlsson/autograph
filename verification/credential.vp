attacker[active]

principal Alice[
	knows public claim_ctx
	knows public endorsement_ctx
	knows public presentation_ctx
	knows private identity_private_key_alice
	identity_key_alice = PUBKEY(identity_private_key_alice)
]

principal Bob[
	knows public endorsement_ctx
	knows public presentation_ctx
	knows private identity_private_key_bob
	identity_key_bob = PUBKEY(identity_private_key_bob)
]

principal Charlie[
	knows public claim_ctx
	knows public endorsement_ctx
	knows private ikc
	ipkc = PUBKEY(ikc)
	knows private identity_private_key_charlie
	identity_key_charlie = PUBKEY(identity_private_key_charlie)
]

Charlie -> Bob: [identity_key_charlie]

principal Alice[
	generates claim
	claim_sig = SIGN(identity_private_key_alice, HASH(claim_ctx, claim))
]

Alice -> Charlie: [identity_key_alice], [claim], claim_sig

principal Charlie[
	_ = SIGNVERIF(identity_key_alice, HASH(claim_ctx, claim), claim_sig)?
	generates endorsement
	endorsement_sig = SIGN(identity_private_key_charlie, HASH(endorsement_ctx, claim, endorsement, identity_key_alice))
]

Charlie -> Alice: identity_key_charlie, endorsement, endorsement_sig

principal Bob[
	generates challenge
]

Bob -> Alice: challenge

principal Alice[
	presentation_sig = SIGN(identity_private_key_alice, HASH(presentation_ctx, claim, challenge))
]

Alice -> Bob: identity_key_alice, claim, endorsement, endorsement_sig, presentation_sig

principal Bob[
	_ = SIGNVERIF(identity_key_charlie, HASH(endorsement_ctx, claim, endorsement, identity_key_alice), endorsement_sig)?
	_ = SIGNVERIF(identity_key_alice, HASH(presentation_ctx, claim, challenge), presentation_sig)?
]

queries[
	authentication? Alice -> Bob: claim
	authentication? Alice -> Bob: endorsement
	freshness? presentation_sig
]
