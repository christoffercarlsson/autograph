attacker[active]

principal Alice[
	knows public certification_ctx, handshake_ctx, session_ctx
]

principal Bob[
	knows public certification_ctx, handshake_ctx, session_ctx
	knows private identity_private_key_bob
	identity_key_bob = PUBKEY(identity_private_key_bob)
]

principal Alice[
	knows private private_key_alice
	public_key_alice = PUBKEY(private_key_alice)
]

principal Alice[
	generates ephemeral_private_key_alice1
	ephemeral_key_alice1 = PUBKEY(ephemeral_private_key_alice1)
]

principal Bob[
	knows private private_key_bob
	public_key_bob = PUBKEY(private_key_bob)
]

principal Bob[
	generates ephemeral_private_key_bob1
	ephemeral_key_bob1 = PUBKEY(ephemeral_private_key_bob1)
]

principal Bob[
	certification_sig = SIGN(identity_private_key_bob, HASH(certification_ctx, ephemeral_key_bob1))
]

Bob -> Alice: [identity_key_bob], public_key_bob, ephemeral_key_bob1, certification_sig

principal Alice[
	_ = SIGNVERIF(identity_key_bob, HASH(certification_ctx, ephemeral_key_bob1), certification_sig)?
]

principal Alice[
	ikm_alice1 = DH_KEX(ephemeral_key_bob1, private_key_alice)
	secret_key_alice1 = HKDF(nil, ikm_alice1, handshake_ctx)
	_session_key_alice1 = HKDF(nil, ikm_alice1, session_ctx)
	_sending_key_alice1 = HKDF(nil, _session_key_alice1, public_key_alice)
	_receiving_key_alice1 = HKDF(nil, _session_key_alice1, ephemeral_key_bob1)
]

principal Alice[
	ikm_alice2 = DH_KEX(public_key_bob, ephemeral_private_key_alice1)
	secret_key_alice2 = HKDF(secret_key_alice1, ikm_alice2, handshake_ctx)
	_session_key_alice2 = HKDF(secret_key_alice1, ikm_alice2, session_ctx)
	_sending_key_alice2 = HKDF(nil, _session_key_alice2, ephemeral_key_alice1)
	_receiving_key_alice2 = HKDF(nil, _session_key_alice2, public_key_bob)
]

principal Alice[
	ikm_alice3 = DH_KEX(ephemeral_key_bob1, ephemeral_private_key_alice1)
	secret_key_alice3 = HKDF(secret_key_alice2, ikm_alice3, handshake_ctx)
	session_key_alice3 = HKDF(secret_key_alice2, ikm_alice3, session_ctx)
	sending_key_alice3 = HKDF(nil, session_key_alice3, ephemeral_key_alice1)
	receiving_key_alice3 = HKDF(nil, session_key_alice3, ephemeral_key_bob1)
]

principal Alice[
	session_id_alice1 = HASH(identity_key_bob, public_key_bob, public_key_alice, ephemeral_key_bob1, ephemeral_key_alice1)
]

principal Alice[
	generates nonce1, message1
	ciphertext1 = AEAD_ENC(sending_key_alice3, nonce1, message1, session_id_alice1)
]

Alice -> Bob: [public_key_alice], ephemeral_key_alice1, nonce1, ciphertext1

principal Bob[
	ikm_bob1 = DH_KEX(public_key_alice, ephemeral_private_key_bob1)
	secret_key_bob1 = HKDF(nil, ikm_bob1, handshake_ctx)
	_session_key_bob1 = HKDF(nil, ikm_bob1, session_ctx)
	_sending_key_bob1 = HKDF(nil, _session_key_bob1, ephemeral_key_bob1)
	_receiving_key_bob1 = HKDF(nil, _session_key_bob1, public_key_alice)
]

principal Bob[
	ikm_bob2 = DH_KEX(ephemeral_key_alice1, private_key_bob)
	secret_key_bob2 = HKDF(secret_key_bob1, ikm_bob2, handshake_ctx)
	_session_key_bob2 = HKDF(secret_key_bob1, ikm_bob2, session_ctx)
	_sending_key_bob2 = HKDF(nil, _session_key_bob2, public_key_bob)
	_receiving_key_bob2 = HKDF(nil, _session_key_bob2, ephemeral_key_alice1)
]

principal Bob[
	ikm_bob3 = DH_KEX(ephemeral_key_alice1, ephemeral_private_key_bob1)
	secret_key_bob3 = HKDF(secret_key_bob2, ikm_bob3, handshake_ctx)
	session_key_bob3 = HKDF(secret_key_bob2, ikm_bob3, session_ctx)
	sending_key_bob3 = HKDF(nil, session_key_bob3, ephemeral_key_bob1)
	receiving_key_bob3 = HKDF(nil, session_key_bob3, ephemeral_key_alice1)
]

principal Bob[
	generates ephemeral_private_key_bob2
	ephemeral_key_bob2 = PUBKEY(ephemeral_private_key_bob2)
]

principal Bob[
	ikm_bob4 = DH_KEX(ephemeral_key_alice1, ephemeral_private_key_bob2)
	secret_key_bob4 = HKDF(secret_key_bob3, ikm_bob4, handshake_ctx)
	session_key_bob4 = HKDF(secret_key_bob3, ikm_bob4, session_ctx)
	sending_key_bob4 = HKDF(nil, session_key_bob4, ephemeral_key_bob2)
	receiving_key_bob4 = HKDF(nil, session_key_bob4, ephemeral_key_alice1)
]

principal Bob[
	session_id_bob1 = HASH(identity_key_bob, public_key_bob, public_key_alice, ephemeral_key_bob1, ephemeral_key_alice1)
]

principal Bob[
	_message1 = AEAD_DEC(receiving_key_bob3, nonce1, ciphertext1, session_id_bob1)?
]

principal Bob[
	generates nonce2, message2
	ciphertext2 = AEAD_ENC(sending_key_bob3, nonce2, message2, session_id_bob1)
]

Bob -> Alice: nonce2, ciphertext2

principal Alice[
	_message2 = AEAD_DEC(receiving_key_alice3, nonce2, ciphertext2, session_id_alice1)?
]

principal Bob[
	session_id_bob2 = HASH(identity_key_bob, public_key_bob, public_key_alice, ephemeral_key_bob2, ephemeral_key_alice1)
]

principal Bob[
	generates nonce3, message3
	ciphertext3 = AEAD_ENC(sending_key_bob4, nonce3, message3, session_id_bob2)
]

Bob -> Alice: ephemeral_key_bob2, nonce3, ciphertext3

principal Alice[
	ikm_alice4 = DH_KEX(ephemeral_key_bob2, ephemeral_private_key_alice1)
	secret_key_alice4 = HKDF(secret_key_alice3, ikm_alice4, handshake_ctx)
	session_key_alice4 = HKDF(secret_key_alice3, ikm_alice4, session_ctx)
	sending_key_alice4 = HKDF(nil, session_key_alice4, ephemeral_key_alice1)
	receiving_key_alice4 = HKDF(nil, session_key_alice4, ephemeral_key_bob2)
]

principal Alice[
	generates ephemeral_private_key_alice2
	ephemeral_key_alice2 = PUBKEY(ephemeral_private_key_alice2)
]

principal Alice[
	ikm_alice5 = DH_KEX(ephemeral_key_bob2, ephemeral_private_key_alice2)
	secret_key_alice5 = HKDF(secret_key_alice4, ikm_alice5, handshake_ctx)
	session_key_alice5 = HKDF(secret_key_alice4, ikm_alice5, session_ctx)
	sending_key_alice5 = HKDF(nil, session_key_alice5, ephemeral_key_alice2)
	receiving_key_alice5 = HKDF(nil, session_key_alice5, ephemeral_key_bob2)
]

principal Alice[
	session_id_alice2 = HASH(identity_key_bob, public_key_bob, public_key_alice, ephemeral_key_bob2, ephemeral_key_alice1)
]

principal Alice[
	_message3 = AEAD_DEC(receiving_key_alice4, nonce3, ciphertext3, session_id_alice2)?
]

principal Alice[
	session_id_alice3 = HASH(identity_key_bob, public_key_bob, public_key_alice, ephemeral_key_bob2, ephemeral_key_alice2)
]

principal Alice[
	generates nonce4, message4
	ciphertext4 = AEAD_ENC(sending_key_alice5, nonce4, message4, session_id_alice3)
]

Alice -> Bob: ephemeral_key_alice2, nonce4, ciphertext4

principal Bob[
	ikm_bob5 = DH_KEX(ephemeral_key_alice2, ephemeral_private_key_bob2)
	secret_key_bob5 = HKDF(secret_key_bob4, ikm_bob5, handshake_ctx)
	session_key_bob5 = HKDF(secret_key_bob4, ikm_bob5, session_ctx)
	sending_key_bob5 = HKDF(nil, session_key_bob5, ephemeral_key_bob2)
	receiving_key_bob5 = HKDF(nil, session_key_bob5, ephemeral_key_alice2)
]

principal Bob[
	session_id_bob3 = HASH(identity_key_bob, public_key_bob, public_key_alice, ephemeral_key_bob2, ephemeral_key_alice2)
]

principal Bob[
	_message4 = AEAD_DEC(receiving_key_bob5, nonce4, ciphertext4, session_id_bob3)?
]

phase[1]

principal Alice[
	leaks private_key_alice
]

principal Bob[
	leaks identity_private_key_bob, private_key_bob
]

queries[
	confidentiality? message1
	authentication? Alice -> Bob: ciphertext1
	confidentiality? message2
	authentication? Bob -> Alice: ciphertext2
	confidentiality? message3
	authentication? Bob -> Alice: ciphertext3
	confidentiality? message4
	authentication? Alice -> Bob: ciphertext4
]
